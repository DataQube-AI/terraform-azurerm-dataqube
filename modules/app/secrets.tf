# Credentials: generated once, kept in Key Vault, delivered to the cluster.
#
# Nothing here reaches Terraform state. Each value is generated ephemerally
# and written to Key Vault write-only (value_wo); the cluster's Secrets are
# then filled write-only (data_wo) from an ephemeral read of Key Vault, which
# stays the single source of truth: a Secret recreated later gets the same
# value, never a new one the databases would reject.
#
# The *_version / *_revision numbers are fixed: a value is written when its
# resource is created and never again. Rotating one is a deliberate procedure
# (see the README), not an apply side effect.

locals {
  generated = {
    "authentik-bootstrap-password"  = { length = 24, kind = "password" }
    "authentik-secret-key"          = { length = 64, kind = "password" }
    "authentik-postgres-password"   = { length = 32, kind = "password" }
    "authentik-postgres-admin-pass" = { length = 32, kind = "password" }
    "app-postgres-password"         = { length = 32, kind = "password" }
    "oidc-client-secret"            = { length = 64, kind = "password" }
    "nextauth-secret"               = { length = 32, kind = "bytes_base64" }
    "ws-ticket-signing-key"         = { length = 32, kind = "bytes_hex" }
    # Seals evidence packs (Ed25519 seed); must stay the same for the life
    # of the installation.
    "evidence-signing-key" = { length = 32, kind = "bytes_hex" }
    # Encrypts database passwords typed into DataQube; losing it makes them
    # unreadable, so it lives in Key Vault with the rest.
    "credential-master-key" = { length = 32, kind = "bytes_hex" }
  }
  bundled_identity = var.identity.type == "bundled"
  # Generated only when used: a managed database brings its own password,
  # and your own identity provider replaces the bundled one and its client.
  generated_here = {
    for k, v in local.generated : k => v
    if !(local.managed_database && k == "app-postgres-password")
    && !(!local.bundled_identity && (startswith(k, "authentik-") || k == "oidc-client-secret"))
  }
  passwords = { for k, v in local.generated_here : k => v if v.kind == "password" }
  bytes     = { for k, v in local.generated_here : k => v if v.kind != "password" }
}

ephemeral "random_password" "generated" {
  for_each = local.passwords
  length   = each.value.length
  special  = false
}

ephemeral "random_bytes" "generated" {
  for_each = local.bytes
  length   = each.value.length
}

resource "azurerm_key_vault_secret" "generated" {
  for_each     = local.generated_here
  name         = "${var.release_name}-${each.key}"
  key_vault_id = var.platform.key_vault.id
  value_wo = (
    each.value.kind == "password" ? ephemeral.random_password.generated[each.key].result :
    each.value.kind == "bytes_hex" ? ephemeral.random_bytes.generated[each.key].hex :
    ephemeral.random_bytes.generated[each.key].base64
  )
  value_wo_version = 1
  content_type     = "generated by terraform-azurerm-dataqube"

  # The platform's RBAC grant must have reached the data plane first.
  depends_on = [terraform_data.key_vault_ready]
}

resource "terraform_data" "key_vault_ready" {
  input = var.platform.key_vault.ready_after
}

ephemeral "azurerm_key_vault_secret" "generated" {
  for_each     = local.generated_here
  name         = azurerm_key_vault_secret.generated[each.key].name
  key_vault_id = var.platform.key_vault.id
  # The version is unknown until the secret exists, which defers this read to
  # apply on the first run instead of reading a secret not yet written.
  version = azurerm_key_vault_secret.generated[each.key].version
}

# Your identity provider's client secret: written once (and on rotation) from
# the ephemeral input, then read back like every other credential.
resource "azurerm_key_vault_secret" "oidc_client_secret" {
  count            = local.bundled_identity ? 0 : 1
  name             = "${var.release_name}-oidc-client-secret"
  key_vault_id     = var.platform.key_vault.id
  value_wo         = var.oidc_client_secret
  value_wo_version = var.identity.oidc.client_secret_version
  content_type     = "OIDC client secret"
  depends_on       = [terraform_data.key_vault_ready]
}

ephemeral "azurerm_key_vault_secret" "oidc_client_secret" {
  count        = local.bundled_identity ? 0 : 1
  name         = azurerm_key_vault_secret.oidc_client_secret[0].name
  key_vault_id = var.platform.key_vault.id
  version      = azurerm_key_vault_secret.oidc_client_secret[0].version
}

# The managed database's administrator password, written by the platform.
ephemeral "azurerm_key_vault_secret" "database" {
  count        = local.managed_database ? 1 : 0
  name         = var.platform.database.password_secret_name
  key_vault_id = var.platform.key_vault.id
  version      = var.platform.database.password_version
}

locals {
  secret = merge(
    { for k, v in ephemeral.azurerm_key_vault_secret.generated : k => v.value },
    local.bundled_identity ? {} : { "oidc-client-secret" = ephemeral.azurerm_key_vault_secret.oidc_client_secret[0].value },
  )
  r = var.release_name
  # TLS verified against the server's name: the managed server is reached by
  # its private DNS name, which its certificate carries.
  database_url = local.managed_database ? format(
    "postgres://%s:%s@%s:5432/%s?sslmode=verify-full",
    var.platform.database.user,
    ephemeral.azurerm_key_vault_secret.database[0].value,
    var.platform.database.host,
    var.platform.database.name,
  ) : "postgres://dataqube:${local.secret["app-postgres-password"]}@${local.r}-app-postgresql:5432/dataqube"
}

resource "kubernetes_namespace_v1" "release" {
  metadata {
    name = var.namespace
  }
}

# The orchestrator and web app.
resource "kubernetes_secret_v1" "runtime" {
  metadata {
    name      = "${local.r}-runtime"
    namespace = kubernetes_namespace_v1.release.metadata[0].name
  }
  data_wo = merge(
    {
      wsTicketSigningKey  = local.secret["ws-ticket-signing-key"]
      oidcClientSecret    = local.secret["oidc-client-secret"]
      nextauthSecret      = local.secret["nextauth-secret"]
      databaseUrl         = local.database_url
      evidenceSigningKey  = local.secret["evidence-signing-key"]
      credentialMasterKey = local.secret["credential-master-key"]
    },
    # Only while rotating the master key: earlier keys still open values
    # wrapped with them until they are re-wrapped under the current one.
    var.credential_master_keys_previous == null ? {} : {
      credentialMasterKeysPrevious = var.credential_master_keys_previous
    },
  )
  # 2: adds evidenceSigningKey and credentialMasterKey. Each raise of
  # credential_master_keys_previous_revision rewrites it again. The Secret is
  # rewritten from Key Vault, so the existing values stay the same.
  data_wo_revision = 2 + var.credential_master_keys_previous_revision
}

# The bundled application database (only when it runs in the cluster).
resource "kubernetes_secret_v1" "app_postgresql" {
  count = local.managed_database ? 0 : 1
  metadata {
    name      = "${local.r}-app-postgresql"
    namespace = kubernetes_namespace_v1.release.metadata[0].name
  }
  data_wo = {
    username = "dataqube"
    password = local.secret["app-postgres-password"]
    database = "dataqube"
  }
  data_wo_revision = 1
}

# The bundled identity provider's complete runtime configuration: with an
# existing Secret the Authentik chart renders none of its own.
resource "kubernetes_secret_v1" "authentik_runtime" {
  count = local.bundled_identity ? 1 : 0
  metadata {
    name      = "${local.r}-authentik-runtime"
    namespace = kubernetes_namespace_v1.release.metadata[0].name
  }
  data_wo = {
    AUTHENTIK_ENABLED                     = "true"
    AUTHENTIK_LOG_LEVEL                   = "info"
    AUTHENTIK_ERROR_REPORTING__ENABLED    = "false"
    AUTHENTIK_POSTGRESQL__HOST            = "${local.r}-postgresql"
    AUTHENTIK_POSTGRESQL__NAME            = "authentik"
    AUTHENTIK_POSTGRESQL__USER            = "authentik"
    AUTHENTIK_POSTGRESQL__PORT            = "5432"
    AUTHENTIK_POSTGRESQL__PASSWORD        = local.secret["authentik-postgres-password"]
    AUTHENTIK_SECRET_KEY                  = local.secret["authentik-secret-key"]
    AUTHENTIK_BOOTSTRAP_PASSWORD          = local.secret["authentik-bootstrap-password"]
    AUTHENTIK_BOOTSTRAP_EMAIL             = var.identity.admin_email
    AUTHENTIK_DATAQUBE_OIDC_CLIENT_SECRET = local.secret["oidc-client-secret"]
  }
  data_wo_revision = 1
}

resource "kubernetes_secret_v1" "authentik_postgresql" {
  count = local.bundled_identity ? 1 : 0
  metadata {
    name      = "${local.r}-authentik-postgresql"
    namespace = kubernetes_namespace_v1.release.metadata[0].name
  }
  data_wo = {
    postgres-password = local.secret["authentik-postgres-admin-pass"]
    password          = local.secret["authentik-postgres-password"]
  }
  data_wo_revision = 1
}

# The model key, referenced by the agent pods (never copied into them).
resource "kubernetes_secret_v1" "llm" {
  metadata {
    name      = "${local.r}-llm"
    namespace = kubernetes_namespace_v1.release.metadata[0].name
  }
  data_wo = {
    apiKey = var.llm_api_key
  }
  data_wo_revision = 1
}

# Your own certificate, read from your Key Vault when applied and written
# write-only into the gateway's TLS secret (the name cert-manager would use).
ephemeral "azurerm_key_vault_certificate" "tls" {
  count        = var.tls.type == "key_vault" ? 1 : 0
  name         = var.tls.key_vault.certificate_name
  key_vault_id = var.tls.key_vault.key_vault_id
}

resource "kubernetes_secret_v1" "tls" {
  count = var.tls.type == "key_vault" ? 1 : 0
  metadata {
    name      = "${local.r}-tls"
    namespace = kubernetes_namespace_v1.release.metadata[0].name
  }
  type = "kubernetes.io/tls"
  data_wo = {
    "tls.crt" = ephemeral.azurerm_key_vault_certificate.tls[0].pem
    "tls.key" = ephemeral.azurerm_key_vault_certificate.tls[0].key
  }
  data_wo_revision = var.tls.key_vault.revision
}
