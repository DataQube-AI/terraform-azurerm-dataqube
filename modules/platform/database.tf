# Azure Database for PostgreSQL flexible server: private access only, from
# the installation's network. The administrator password is generated
# ephemerally and written write-only to the server and to Key Vault in the
# same apply — it never enters Terraform state. modules/app reads it back
# from Key Vault to build the connection the orchestrator uses.

locals {
  managed_database = var.database.type == "azure_flexible"
  database_admin   = "dataqube_admin"
  database_name    = "dataqube"
}

resource "azurerm_private_dns_zone" "database" {
  count               = local.managed_database ? 1 : 0
  name                = "${local.base}.private.postgres.database.azure.com"
  resource_group_name = azurerm_resource_group.this.name
  tags                = local.tags
}

resource "azurerm_private_dns_zone_virtual_network_link" "database" {
  count               = local.managed_database ? 1 : 0
  name                = "vnet-${local.base}"
  private_dns_zone_id = azurerm_private_dns_zone.database[0].id
  virtual_network_id  = azurerm_virtual_network.this[0].id
  tags                = local.tags
}

ephemeral "random_password" "database_admin" {
  count   = local.managed_database ? 1 : 0
  length  = 32
  special = false
}

resource "azurerm_key_vault_secret" "database_admin" {
  count            = local.managed_database ? 1 : 0
  name             = "database-admin-password"
  key_vault_id     = azurerm_key_vault.this.id
  value_wo         = ephemeral.random_password.database_admin[0].result
  value_wo_version = 1
  content_type     = "generated by terraform-azurerm-dataqube"
  depends_on       = [time_sleep.key_vault_rbac]
}

resource "azurerm_postgresql_flexible_server" "this" {
  count                             = local.managed_database ? 1 : 0
  name                              = "psql-${local.base}-${local.suffix}"
  resource_group_name               = azurerm_resource_group.this.name
  location                          = azurerm_resource_group.this.location
  version                           = "18"
  sku_name                          = var.database.sku_name
  storage_mb                        = var.database.storage_mb
  auto_grow_enabled                 = true
  backup_retention_days             = var.database.backup_retention_days
  geo_redundant_backup_enabled      = var.database.geo_redundant_backup_enabled
  delegated_subnet_id               = azurerm_subnet.database[0].id
  private_dns_zone_id               = azurerm_private_dns_zone.database[0].id
  public_network_access_enabled     = false
  administrator_login               = local.database_admin
  administrator_password_wo         = ephemeral.random_password.database_admin[0].result
  administrator_password_wo_version = 1

  dynamic "high_availability" {
    for_each = var.database.high_availability ? [1] : []
    content {
      mode = "ZoneRedundant"
    }
  }

  tags = local.tags

  depends_on = [azurerm_private_dns_zone_virtual_network_link.database]

  lifecycle {
    # Azure picks the zone at creation; moving it is a failover, not a plan.
    ignore_changes = [zone, high_availability[0].standby_availability_zone]
  }
}

# The migrations create these extensions; Azure allows only listed ones.
resource "azurerm_postgresql_flexible_server_configuration" "extensions" {
  count     = local.managed_database ? 1 : 0
  name      = "azure.extensions"
  server_id = azurerm_postgresql_flexible_server.this[0].id
  value     = "VECTOR,PG_TRGM"
}

resource "azurerm_postgresql_flexible_server_database" "dataqube" {
  count     = local.managed_database ? 1 : 0
  name      = local.database_name
  server_id = azurerm_postgresql_flexible_server.this[0].id
  charset   = "UTF8"
  collation = "en_US.utf8"
}
